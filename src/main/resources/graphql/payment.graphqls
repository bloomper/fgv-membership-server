enum PaymentStatus {
    "Not paid yet"
    OPEN
    "The payer says they paid; waits for the treasurer"
    REPORTED
    MATCHED
    CANCELLED
}

enum PaymentHow {
    SWISH
    BANK_TRANSFER
    CASH
    "Paid in another application, which told us (the treasurer does not record these)"
    ONLINE
}

extend type Query {
    "USER. The caller's memberships and payment requests. linked is false when their account has no spexare."
    myMembership: MyMembership!
    "USER. Fees members may pick, highest first; for the year and for life, or only the year's and life."
    feeLevels(year: Int): [FeeLevel!]!
    "USER. A payment request, the caller's own, or anyone's for the treasurer."
    paymentRequest(id: ID!): PaymentRequest!
    "TREASURER. Requests that are open or reported, oldest first, with who they are for."
    waitingPaymentRequests: [PaymentRequest!]!
    "ADMIN. Every fee level, retired ones too."
    allFeeLevels: [FeeLevel!]!
}

extend type Mutation {
    """
    USER. Asks to pay these fee levels (one for each year, or the life fee). The memberships are created as pending. With a
    family fee the payer says who the other family members are in familyNote, and the board attaches them.
    """
    requestPayment(feeLevelIds: [ID!]!, familyNote: String): PaymentRequest!
    """
    BOARD. Gives these spexare the membership that a family request pays for, in the state the payer's is in. Up to 10 people
    in a family.
    """
    addFamilyMembers(requestId: ID!, spexareIds: [ID!]!): PaymentRequest!
    "USER. Says that the request is paid, perhaps by someone else (paidBy)."
    reportPaid(id: ID!, paidBy: String): PaymentRequest!
    "TREASURER. The money arrived: the memberships become paid and the payer gets a receipt. paidOn is a date, yyyy-mm-dd."
    recordPayment(requestId: ID!, paidOn: String!, amount: Int!, how: PaymentHow!, note: String): PaymentRequest!
    "TREASURER. Drops an open or reported request and cancels its memberships."
    cancelPaymentRequest(id: ID!): PaymentRequest!
    "ADMIN. Creates a fee level, or changes one when id is given."
    feeLevelSave(input: FeeLevelInput!): FeeLevel!
    "ADMIN. Retired fee levels are not offered, and stay on what was paid."
    feeLevelRetire(id: ID!, retired: Boolean!): FeeLevel!
}

enum FeeKind {
    "One person, for a year"
    STANDARD
    "A family, for a year: one pays and every family member is a member"
    FAMILY
    "One person, for life from the year it is paid"
    LIFETIME
    "A support membership (stödmedlemskap): a person, for a year, at another price and with other access"
    SUPPORT
}

input FeeLevelInput {
    id: ID
    "The year a yearly fee is for; for a life fee the first year it is offered, or null"
    year: Int
    "Use kind; lifetime true means LIFETIME when kind is not given"
    lifetime: Boolean! = false
    kind: FeeKind
    nameSv: String!
    nameEn: String!
    "Whole kronor"
    amount: Int!
}

type FeeLevel {
    id: ID!
    year: Int
    kind: FeeKind!
    lifetime: Boolean!
    nameSv: String!
    nameEn: String!
    amount: Int!
    retired: Boolean!
}

type MyMembership {
    linked: Boolean!
    memberships: [MembershipItem!]!
    requests: [PaymentRequest!]!
}

type MembershipItem {
    id: ID!
    type: String!
    year: Int!
    lifetime: Boolean!
    "PENDING, REPORTED, PAID, WAIVED or CANCELLED"
    status: String!
}

type PaymentRequest {
    id: ID!
    reference: String!
    amount: Int!
    status: PaymentStatus!
    createdAt: String!
    reportedAt: String
    paidBy: String
    "Null for a request a revival pays for its participants"
    spexareId: ID
    "Only for the treasurer's lists; for a revival's request, who pays"
    spexareName: String
    "What has been paid so far, in whole kronor; less than amount leaves the request open"
    paid: Int!
    "A family request: one pays and the whole family is a member"
    family: Boolean!
    "Who the payer said the other family members are"
    familyNote: String
    "A family request that only has the payer so far: the board has to attach the others"
    familyIncomplete: Boolean!
    "BOARD. The people the request's memberships are for"
    familyMembers: [SpexarePerson!]!
    "Paid in another application: which one, and its own id for the payment"
    externalSource: String
    externalReference: String
    memberships: [PaymentItem!]!
    payee: Payee!
    "Opens Swish with number, amount and reference filled in, on a phone. Null once paid or when there is no Swish number."
    swishLink: String
    "A QR code of the same, as a data: URI; null when Swish cannot be reached."
    qr: String
}

type PaymentItem {
    id: ID!
    spexareId: ID
    year: Int!
    lifetime: Boolean!
    status: String!
}

type Payee {
    swishNumber: String
    "Pay to the bankgiro with the reference as the message"
    bankgiro: String
    "For a direct bank transfer; may be empty"
    bankAccount: String
    name: String!
}

extend type Query {
    "REVIVAL. The yearly fees (not the life fee) for the year, or for every year."
    revivalFeeLevels(year: Int): [FeeLevel!]!
}

extend type Mutation {
    """
    REVIVAL. One payment request that covers the FGV fee for these participants (spexare ids) for the fee's year. Those who
    are members that year already are left out and listed. The revival pays the total with the reference; the treasurer
    matches it, and the memberships become paid, with the revival as the payer.
    """
    createRevivalPaymentRequest(payerLabel: String!, spexareIds: [ID!]!, feeLevelId: ID!): RevivalPaymentRequest!
}

type RevivalPaymentRequest {
    requestId: ID!
    reference: String!
    amount: Int!
    "How many participants the request covers"
    included: Int!
    alreadyMembers: [ID!]!
    payee: Payee!
}
