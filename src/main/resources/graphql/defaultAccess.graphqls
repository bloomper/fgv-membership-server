extend type Query {
    "ADMIN. The access a user gets when an account is created from a payment made elsewhere, for each application."
    defaultAccess: [DefaultAccess!]!
}

extend type Mutation {
    "ADMIN. Sets the highest role new users get on an application (roles below it come with it); null gives none."
    setDefaultAccess(clientId: String!, role: String): DefaultAccess!
}

type DefaultAccess {
    clientId: String!
    name: String!
    ladder: [String!]!
    role: String
}
